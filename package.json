{
  "name": "xtooey",
  "version": "0.1.0",
  "description": "A fast, image-capable X client for the terminal",
  "author": "Kommander",
  "license": "MIT",
  "keywords": [
    "x",
    "twitter",
    "tui",
    "terminal",
    "opentui",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kommander/xtui.git"
  },
  "homepage": "https://github.com/kommander/xtui#readme",
  "bugs": {
    "url": "https://github.com/kommander/xtui/issues"
  },
  "type": "module",
  "bin": {
    "xtooey": "src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/browser-preference.ts",
    "src/config.ts",
    "xtooey.schema.json",
    "RELEASING.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "schema": "bun scripts/config-schema.ts",
    "package:smoke": "bun scripts/package-smoke.ts",
    "release:check": "bun run typecheck && bun run fmt:check && bun run lint && bun test && npm pack --dry-run && bun run package:smoke",
    "prepublishOnly": "bun run typecheck && bun run fmt:check && bun run lint && bun test",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/keymap": "0.5.1",
    "@steipete/bird": "0.8.0",
    "@steipete/sweet-cookie": "0.4.1",
    "jsonc-parser": "3.3.1",
    "web-tree-sitter": "0.25.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@steipete/sweet-cookie": "0.4.1"
  }
}
