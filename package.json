{
  "name": "xtui",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, image-capable X client for the terminal",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "schema": "bun scripts/config-schema.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/keymap": "0.5.1",
    "@steipete/bird": "0.8.0",
    "@steipete/sweet-cookie": "0.4.1",
    "jsonc-parser": "3.3.1",
    "opentui-spinner": "0.0.7",
    "web-tree-sitter": "0.25.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@steipete/sweet-cookie": "0.4.1"
  }
}
